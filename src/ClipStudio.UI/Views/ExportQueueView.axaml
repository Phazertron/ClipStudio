<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClipStudio.UI.ViewModels"
             xmlns:icons="using:Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="ClipStudio.UI.Views.ExportQueueView"
             x:DataType="vm:ExportQueueViewModel"
             x:CompileBindings="True">

    <UserControl.Styles>
        <!-- Destructive trim mode badge: red background + red text -->
        <Style Selector="Border.destructive">
            <Setter Property="Background" Value="#3DE74C3C"/>
        </Style>
        <Style Selector="Border.destructive TextBlock">
            <Setter Property="Foreground" Value="#E74C3C"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- ===== Toolbar ===== -->
        <Border Grid.Row="0"
                Padding="16,10"
                BorderBrush="{DynamicResource SystemChromeHighColor}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">

                <!-- Pending count badge -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock Text="Export Queue"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Border Padding="8,3"
                            CornerRadius="10"
                            Background="{DynamicResource SystemChromeLowColor}"
                            VerticalAlignment="Center"
                            IsVisible="{Binding PendingCount}">
                        <TextBlock Text="{Binding PendingCount, StringFormat='{}{0} pending'}"
                                   FontSize="11"
                                   Opacity="0.7"/>
                    </Border>
                </StackPanel>

                <!-- Status message -->
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           FontSize="12"
                           Opacity="0.6"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <!-- Refresh -->
                <Button Grid.Column="2"
                        Command="{Binding LoadCommand}"
                        Content="Refresh"
                        Margin="0,0,6,0"/>

                <!-- Process queue -->
                <Button Grid.Column="3"
                        Command="{Binding ProcessQueueCommand}"
                        IsVisible="{Binding PendingCount}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="PlayBox" Width="16" Height="16"
                                            IsVisible="{Binding !IsProcessing}"/>
                        <ProgressBar IsIndeterminate="True"
                                     Width="16" Height="16"
                                     IsVisible="{Binding IsProcessing}"/>
                        <TextBlock Text="Process Queue" FontSize="12"/>
                    </StackPanel>
                </Button>

            </Grid>
        </Border>

        <!-- Loading indicator -->
        <ProgressBar Grid.Row="0"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}"
                     VerticalAlignment="Bottom"
                     Height="2"
                     Margin="0"/>

        <!-- ===== Job list ===== -->
        <ScrollViewer Grid.Row="1" Padding="12">
            <StackPanel Spacing="16">

                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Margin="0,60,0,0"
                            IsVisible="{Binding !PendingJobs.Count}">
                    <icons:MaterialIcon Kind="Tray" Width="48" Height="48" Opacity="0.2"
                                        HorizontalAlignment="Center"
                                        IsVisible="{Binding !CompletedJobs.Count}"/>
                    <TextBlock Text="No export jobs yet."
                               FontSize="15"
                               Opacity="0.4"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding !CompletedJobs.Count}"/>
                    <TextBlock Text="Queue an export from the Clip Detail view."
                               FontSize="12"
                               Opacity="0.3"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding !CompletedJobs.Count}"/>
                </StackPanel>

                <!-- ===== Pending section ===== -->
                <StackPanel IsVisible="{Binding PendingJobs.Count}" Spacing="6">
                    <TextBlock Text="Pending"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Opacity="0.5"
                               Margin="2,0,0,2"/>
                    <ItemsControl ItemsSource="{Binding PendingJobs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ExportJobRowViewModel">
                                <Border Margin="0,0,0,6"
                                        Padding="12,10"
                                        CornerRadius="6"
                                        Background="{DynamicResource SystemChromeMediumLowColor}"
                                        BorderBrush="{DynamicResource SystemChromeHighColor}"
                                        BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,*,Auto">

                                        <!-- Status icon -->
                                        <Panel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <icons:MaterialIcon Kind="TimerSand" Width="20" Height="20"
                                                                IsVisible="{Binding IsPending}"/>
                                            <ProgressBar IsIndeterminate="True"
                                                         Width="20" Height="20"
                                                         IsVisible="{Binding !IsPending}"/>
                                        </Panel>

                                        <!-- Job details -->
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding ClipName}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"/>
                                                <Border Padding="5,1"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource SystemChromeLowColor}">
                                                    <TextBlock Text="{Binding HighlightLabel}"
                                                               FontSize="11"
                                                               Opacity="0.7"/>
                                                </Border>
                                                <Border Padding="5,1"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource SystemChromeLowColor}"
                                                        Classes.destructive="{Binding IsDestructive}">
                                                    <TextBlock Text="{Binding TrimModeLabel}"
                                                               FontSize="11"
                                                               Opacity="0.7"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding OutputPath}"
                                                       FontSize="11"
                                                       Opacity="0.55"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Timestamps + cancel -->
                                        <StackPanel Grid.Column="2"
                                                    Spacing="4"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Margin="12,0,0,0">
                                            <TextBlock Text="{Binding StatusLabel}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding CreatedAtDisplay}"
                                                       FontSize="11"
                                                       Opacity="0.5"
                                                       HorizontalAlignment="Right"/>
                                            <Button Command="{Binding CancelCommand}"
                                                    IsVisible="{Binding IsPending}"
                                                    Padding="8,3"
                                                    Foreground="#E74C3C"
                                                    HorizontalAlignment="Right">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <icons:MaterialIcon Kind="Close" Width="12" Height="12"/>
                                                    <TextBlock Text="Cancel" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ===== Completed section ===== -->
                <StackPanel IsVisible="{Binding CompletedJobs.Count}" Spacing="6">
                    <TextBlock Text="Completed"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Opacity="0.5"
                               Margin="2,0,0,2"/>
                    <ItemsControl ItemsSource="{Binding CompletedJobs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ExportJobRowViewModel">
                                <Border Margin="0,0,0,6"
                                        Padding="12,10"
                                        CornerRadius="6"
                                        Background="{DynamicResource SystemChromeMediumLowColor}"
                                        BorderBrush="{DynamicResource SystemChromeHighColor}"
                                        BorderThickness="1"
                                        Opacity="0.75">
                                    <Grid ColumnDefinitions="Auto,*,Auto">

                                        <!-- Status icon -->
                                        <Panel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <icons:MaterialIcon Kind="CheckCircle" Width="20" Height="20"
                                                                Foreground="#2ECC71"
                                                                IsVisible="{Binding IsCompleted}"/>
                                            <icons:MaterialIcon Kind="AlertCircle" Width="20" Height="20"
                                                                Foreground="#E74C3C"
                                                                IsVisible="{Binding IsFailed}"/>
                                            <icons:MaterialIcon Kind="Cancel" Width="20" Height="20"
                                                                Foreground="#95A5A6"
                                                                IsVisible="{Binding IsCancelled}"/>
                                        </Panel>

                                        <!-- Job details -->
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding ClipName}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"/>
                                                <Border Padding="5,1"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource SystemChromeLowColor}">
                                                    <TextBlock Text="{Binding HighlightLabel}"
                                                               FontSize="11"
                                                               Opacity="0.7"/>
                                                </Border>
                                                <Border Padding="5,1"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource SystemChromeLowColor}"
                                                        Classes.destructive="{Binding IsDestructive}">
                                                    <TextBlock Text="{Binding TrimModeLabel}"
                                                               FontSize="11"
                                                               Opacity="0.7"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding OutputPath}"
                                                       FontSize="11"
                                                       Opacity="0.55"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <!-- Error message -->
                                            <TextBlock Text="{Binding ErrorMessage}"
                                                       FontSize="11"
                                                       Foreground="#E74C3C"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding IsFailed}"/>
                                        </StackPanel>

                                        <!-- Timestamps -->
                                        <StackPanel Grid.Column="2"
                                                    Spacing="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Margin="12,0,0,0">
                                            <TextBlock Text="{Binding StatusLabel}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding CreatedAtDisplay}"
                                                       FontSize="11"
                                                       Opacity="0.5"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding CompletedAtDisplay}"
                                                       FontSize="11"
                                                       Opacity="0.5"
                                                       HorizontalAlignment="Right"/>
                                        </StackPanel>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
