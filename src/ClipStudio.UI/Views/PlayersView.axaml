<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClipStudio.UI.ViewModels"
             xmlns:entities="using:ClipStudio.Core.Entities"
             xmlns:icons="using:Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="ClipStudio.UI.Views.PlayersView"
             x:DataType="vm:PlayersViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- ===== Toolbar ===== -->
        <Border Grid.Row="0"
                Padding="16,10"
                BorderBrush="{DynamicResource SystemChromeHighColor}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto">

                <!-- Filter box -->
                <TextBox Grid.Column="0"
                         Text="{Binding FilterText}"
                         Watermark="Filter players..."
                         MaxWidth="320"
                         HorizontalAlignment="Left"
                         CornerRadius="6"/>

                <!-- Refresh -->
                <Button Grid.Column="1"
                        Command="{Binding LoadCommand}"
                        Content="Refresh"
                        Margin="8,0,0,0"/>

                <!-- Add player -->
                <Button Grid.Column="2"
                        Command="{Binding BeginCreateCommand}"
                        ToolTip.Tip="Add player"
                        Margin="6,0,0,0">
                    <icons:MaterialIcon Kind="AccountPlus" Width="18" Height="18"/>
                </Button>

            </Grid>
        </Border>

        <!-- Loading indicator -->
        <ProgressBar Grid.Row="0"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}"
                     VerticalAlignment="Bottom"
                     Height="2"
                     Margin="0"/>

        <!-- ===== Main content: list + edit panel ===== -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

            <!-- Players list -->
            <ScrollViewer Grid.Column="0">
                <Panel Margin="12,12,12,24">

                    <!-- Empty state -->
                    <TextBlock Text="No players found. Add a player using the button above."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="15"
                               Opacity="0.4"
                               TextWrapping="Wrap"
                               MaxWidth="320"
                               TextAlignment="Center"
                               IsVisible="{Binding !Players.Count}"/>

                    <ItemsControl ItemsSource="{Binding Players}"
                                  IsVisible="{Binding Players.Count}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:PlayerRowViewModel">
                                <Border Margin="0,0,0,4"
                                        Padding="10,8"
                                        CornerRadius="6"
                                        Background="{DynamicResource SystemChromeMediumLowColor}"
                                        BorderBrush="{DynamicResource SystemChromeHighColor}"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Tapped="OnPlayerRowTapped">
                                    <Grid ColumnDefinitions="Auto,*,Auto">

                                        <!-- Icon or fallback -->
                                        <Panel Grid.Column="0" Width="36" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Image Source="{Binding IconBitmap}"
                                                   Width="32" Height="32"
                                                   Stretch="UniformToFill"
                                                   IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                            <icons:MaterialIcon Kind="AccountCircle"
                                                                Width="28" Height="28"
                                                                Opacity="0.35"
                                                                IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNull}}"/>
                                        </Panel>

                                        <!-- Name + aliases + IsMe badge -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"/>
                                                <Border Padding="5,1"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource SystemAccentColor}"
                                                        IsVisible="{Binding IsMe}">
                                                    <TextBlock Text="Me"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding AliasesDisplay}"
                                                       FontSize="11"
                                                       Opacity="0.55"
                                                       IsVisible="{Binding AliasesDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>

                                        <!-- Delete -->
                                        <Button Grid.Column="2"
                                                Command="{Binding DeleteCommand}"
                                                ToolTip.Tip="Delete player"
                                                Padding="5">
                                            <icons:MaterialIcon Kind="DeleteCircle" Width="15" Height="15"/>
                                        </Button>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </Panel>
            </ScrollViewer>

            <!-- ===== Add / Edit panel ===== -->
            <Border Grid.Column="1"
                    Width="300"
                    BorderBrush="{DynamicResource SystemChromeHighColor}"
                    BorderThickness="1,0,0,0"
                    IsVisible="{Binding IsEditing}">

                <ScrollViewer>
                    <StackPanel Margin="16" Spacing="10">

                        <!-- Form title + close button -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding EditFormTitle}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Command="{Binding CancelEditCommand}"
                                    ToolTip.Tip="Cancel"
                                    Padding="4">
                                <icons:MaterialIcon Kind="CloseThick" Width="16" Height="16"/>
                            </Button>
                        </Grid>

                        <!-- Name -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Display name" FontSize="12" Opacity="0.7"/>
                            <TextBox Text="{Binding EditName}"
                                     Watermark="Player display name"
                                     FontSize="12"/>
                        </StackPanel>

                        <!-- IsMe toggle -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="This is me (auto-tag new imports)"
                                       FontSize="12"
                                       Opacity="0.7"/>
                            <ToggleSwitch IsChecked="{Binding EditIsMe}"
                                          OnContent="Yes"
                                          OffContent="No"
                                          FontSize="12"/>
                        </StackPanel>

                        <!-- Icon path -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Icon image (optional)" FontSize="12" Opacity="0.7"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0"
                                         Text="{Binding EditIconPath}"
                                         Watermark="Path to image file..."
                                         FontSize="11"/>
                                <Button Grid.Column="1"
                                        Command="{Binding BrowseIconCommand}"
                                        ToolTip.Tip="Browse for icon"
                                        Margin="4,0,0,0"
                                        Padding="6">
                                    <icons:MaterialIcon Kind="FolderOpen" Width="14" Height="14"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Aliases section — shown for both new and existing players -->
                        <StackPanel Spacing="6">

                            <Border Height="1" Background="{DynamicResource SystemChromeHighColor}" Margin="0,2"/>

                            <TextBlock Text="Aliases"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Opacity="0.7"/>

                            <!-- Saved alias chips (existing player) -->
                            <ItemsControl ItemsSource="{Binding EditingAliases}"
                                          IsVisible="{Binding EditingPlayerId.HasValue}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="entities:PlayerAlias">
                                        <Border CornerRadius="10"
                                                Padding="6,2"
                                                Margin="2"
                                                Background="{DynamicResource SystemChromeMediumColor}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{Binding Alias}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"/>
                                                <Button Padding="0"
                                                        Width="13" Height="13"
                                                        VerticalAlignment="Center"
                                                        Click="OnRemoveAliasClicked"
                                                        Tag="{Binding}">
                                                    <icons:MaterialIcon Kind="Close" Width="9" Height="9"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Pending alias chips (new player not yet saved) -->
                            <ItemsControl ItemsSource="{Binding PendingAliases}"
                                          IsVisible="{Binding !EditingPlayerId.HasValue}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="x:String">
                                        <Border CornerRadius="10"
                                                Padding="6,2"
                                                Margin="2"
                                                Background="{DynamicResource SystemChromeMediumColor}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{Binding}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"/>
                                                <Button Padding="0"
                                                        Width="13" Height="13"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding $parent[UserControl].DataContext.RemovePendingAliasCommand}"
                                                        CommandParameter="{Binding}">
                                                    <icons:MaterialIcon Kind="Close" Width="9" Height="9"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Add alias row -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0"
                                         Text="{Binding EditAliasText}"
                                         Watermark="Alias name..."
                                         FontSize="11"/>
                                <Button Grid.Column="1"
                                        Command="{Binding AddAliasCommand}"
                                        Content="Add"
                                        FontSize="11"
                                        Margin="4,0,0,0"/>
                            </Grid>

                        </StackPanel>

                        <!-- Error message -->
                        <TextBlock Text="{Binding SaveError}"
                                   FontSize="12"
                                   Foreground="#E74C3C"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding SaveError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        <!-- Save -->
                        <Button Command="{Binding SaveCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                FontSize="12">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="ContentSave" Width="16" Height="16"/>
                                <TextBlock Text="Save Player"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>
</UserControl>
