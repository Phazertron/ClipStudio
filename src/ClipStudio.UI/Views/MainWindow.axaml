<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClipStudio.UI.ViewModels"
        xmlns:icons="using:Material.Icons.Avalonia"
        xmlns:conv="using:ClipStudio.UI.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="ClipStudio.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="ClipStudio"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="220,*">

        <!-- ===== Sidebar ===== -->
        <Border Grid.Column="0"
                Background="{DynamicResource SystemChromeMediumLowColor}"
                BorderBrush="{DynamicResource SystemChromeHighColor}"
                BorderThickness="0,0,1,0">

            <DockPanel>

                <!-- App title -->
                <Border DockPanel.Dock="Top"
                        Padding="16,20,16,12"
                        BorderBrush="{DynamicResource SystemChromeHighColor}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Spacing="2">
                        <TextBlock Text="ClipStudio"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Clip Manager"
                                   FontSize="11"
                                   Opacity="0.5"/>
                    </StackPanel>
                </Border>

                <!-- Navigation items -->
                <ListBox DockPanel.Dock="Top"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem}"
                         Background="Transparent"
                         Padding="8,8,8,0">

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:NavigationItemViewModel">
                            <Grid ColumnDefinitions="Auto,*" Margin="0,2">

                                <!-- Icon with scan animation and badge overlay -->
                                <Panel Grid.Column="0"
                                       Width="20" Height="20"
                                       VerticalAlignment="Center"
                                       Margin="4,0,10,0">

                                    <!-- Normal icon (hidden while scanning) -->
                                    <icons:MaterialIcon Kind="{Binding Icon}"
                                                        Width="20" Height="20"
                                                        IsVisible="{Binding !ShowSpinner}"/>

                                    <!-- Spinning cog shown during scan/import -->
                                    <icons:MaterialIcon Kind="Cog"
                                                        Width="20" Height="20"
                                                        IsVisible="{Binding ShowSpinner}"
                                                        RenderTransformOrigin="50%,50%">
                                        <icons:MaterialIcon.RenderTransform>
                                            <RotateTransform/>
                                        </icons:MaterialIcon.RenderTransform>
                                        <icons:MaterialIcon.Styles>
                                            <Style Selector="icons|MaterialIcon[IsVisible=True]">
                                                <Style.Animations>
                                                    <Animation Duration="0:0:1.5" IterationCount="INFINITE">
                                                        <KeyFrame Cue="0%">
                                                            <Setter Property="RotateTransform.Angle" Value="0"/>
                                                        </KeyFrame>
                                                        <KeyFrame Cue="100%">
                                                            <Setter Property="RotateTransform.Angle" Value="360"/>
                                                        </KeyFrame>
                                                    </Animation>
                                                </Style.Animations>
                                            </Style>
                                        </icons:MaterialIcon.Styles>
                                    </icons:MaterialIcon>

                                    <!-- Badge overlay (unreviewed count) -->
                                    <Border IsVisible="{Binding BadgeCount, Converter={x:Static conv:IsPositiveConverter.Instance}}"
                                            Background="#CC2200"
                                            CornerRadius="7"
                                            MinWidth="14" Height="14"
                                            Padding="2,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,-5,-5,0">
                                        <TextBlock Text="{Binding BadgeCount}"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Panel>

                                <!-- Label -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Label}"
                                           VerticalAlignment="Center"
                                           FontSize="13"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </ListBox.Styles>
                </ListBox>


                <!-- Activity indicator: docked to the bottom so it is reachable from every page.
                     Whatever is running is visible here even when the page that started it is not
                     on screen, and a finished task's message stays readable in full instead of
                     being truncated by whatever bar it was reported into. -->
                <Border DockPanel.Dock="Bottom"
                        Padding="10,8"
                        BorderBrush="{DynamicResource SystemChromeHighColor}"
                        BorderThickness="0,1,0,0">
                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,6"
                            ToolTip.Tip="Background activity">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <!-- Idle -->
                            <icons:MaterialIcon Grid.Column="0"
                                                Kind="CheckCircleOutline"
                                                Width="16" Height="16"
                                                Opacity="0.4"
                                                IsVisible="{Binding !HasRunningTasks}"
                                                VerticalAlignment="Center"/>

                            <!-- Busy: the same spinning cog the navigation items use -->
                            <icons:MaterialIcon Grid.Column="0"
                                                Kind="Cog"
                                                Width="16" Height="16"
                                                IsVisible="{Binding HasRunningTasks}"
                                                VerticalAlignment="Center"
                                                RenderTransformOrigin="50%,50%">
                                <icons:MaterialIcon.RenderTransform>
                                    <RotateTransform/>
                                </icons:MaterialIcon.RenderTransform>
                                <icons:MaterialIcon.Styles>
                                    <Style Selector="icons|MaterialIcon[IsVisible=True]">
                                        <Style.Animations>
                                            <Animation Duration="0:0:1.5" IterationCount="INFINITE">
                                                <KeyFrame Cue="0%">
                                                    <Setter Property="RotateTransform.Angle" Value="0"/>
                                                </KeyFrame>
                                                <KeyFrame Cue="100%">
                                                    <Setter Property="RotateTransform.Angle" Value="360"/>
                                                </KeyFrame>
                                            </Animation>
                                        </Style.Animations>
                                    </Style>
                                </icons:MaterialIcon.Styles>
                            </icons:MaterialIcon>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding ActivitySummary}"
                                       FontSize="11"
                                       Opacity="0.7"
                                       Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>

                            <icons:MaterialIcon Grid.Column="2"
                                                Kind="ChevronUp"
                                                Width="14" Height="14"
                                                Opacity="0.5"
                                                VerticalAlignment="Center"/>
                        </Grid>

                        <Button.Flyout>
                            <Flyout Placement="RightEdgeAlignedBottom">
                                <Border Width="360" Padding="4">
                                    <StackPanel Spacing="10">

                                        <TextBlock Text="Background activity"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="Nothing is running, and nothing has finished this session."
                                                   FontSize="11"
                                                   Opacity="0.6"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding IsActivityEmpty}"/>

                                        <!-- Running -->
                                        <ItemsControl ItemsSource="{Binding Tasks.Running}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:BackgroundTaskViewModel">
                                                    <Border Margin="0,0,0,8"
                                                            Padding="10"
                                                            CornerRadius="6"
                                                            Background="{DynamicResource SystemChromeLowColor}">
                                                        <StackPanel Spacing="6">
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <icons:MaterialIcon Grid.Column="0"
                                                                                    Kind="{Binding Icon}"
                                                                                    Width="14" Height="14"
                                                                                    VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Title}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Margin="8,0,0,0"
                                                                           TextWrapping="Wrap"
                                                                           VerticalAlignment="Center"/>
                                                                <Button Grid.Column="2"
                                                                        Command="{Binding CancelCommand}"
                                                                        IsVisible="{Binding CanCancel}"
                                                                        Padding="4"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        ToolTip.Tip="Stop this task">
                                                                    <icons:MaterialIcon Kind="Close" Width="12" Height="12"/>
                                                                </Button>
                                                            </Grid>

                                                            <ProgressBar Value="{Binding ProgressPercent}"
                                                                         IsIndeterminate="{Binding IsIndeterminate}"
                                                                         Minimum="0" Maximum="100"
                                                                         Height="4"/>

                                                            <TextBlock Text="{Binding Detail}"
                                                                       FontSize="10"
                                                                       Opacity="0.6"
                                                                       TextWrapping="Wrap"
                                                                       IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Recently finished -->
                                        <Grid ColumnDefinitions="*,Auto"
                                              IsVisible="{Binding HasRecentTasks}">
                                            <TextBlock Grid.Column="0"
                                                       Text="Recently finished"
                                                       FontSize="11"
                                                       Opacity="0.6"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="1"
                                                    Command="{Binding ClearFinishedTasksCommand}"
                                                    Content="Clear"
                                                    FontSize="10"
                                                    Padding="6,2"/>
                                        </Grid>

                                        <ScrollViewer MaxHeight="260">
                                            <ItemsControl ItemsSource="{Binding Tasks.Recent}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:BackgroundTaskViewModel">
                                                        <Border Margin="0,0,0,6"
                                                                Padding="10"
                                                                CornerRadius="6"
                                                                Background="{DynamicResource SystemChromeLowColor}">
                                                            <StackPanel Spacing="4">
                                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                    <icons:MaterialIcon Grid.Column="0"
                                                                                        Kind="{Binding Icon}"
                                                                                        Width="14" Height="14"
                                                                                        Opacity="0.6"
                                                                                        VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding Title}"
                                                                               FontSize="12"
                                                                               Margin="8,0,0,0"
                                                                               TextWrapping="Wrap"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="2"
                                                                               Text="{Binding StateDisplay}"
                                                                               FontSize="10"
                                                                               Opacity="0.5"
                                                                               VerticalAlignment="Center"/>
                                                                </Grid>

                                                                <!-- In full, and wrapped. This is the line that used
                                                                     to run off the edge of the settings page. -->
                                                                <TextBlock Text="{Binding CompletionMessage}"
                                                                           FontSize="10"
                                                                           Opacity="0.7"
                                                                           TextWrapping="Wrap"
                                                                           IsVisible="{Binding CompletionMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Border>

                <!-- Spacer -->
                <Grid DockPanel.Dock="Top"/>

            </DockPanel>
        </Border>

        <!-- ===== Content area ===== -->
        <Panel Grid.Column="1">
            <ContentControl Content="{Binding CurrentPage}"/>

            <!-- Startup loading overlay — shown until heavy initialisation completes -->
            <Border IsVisible="{Binding IsStartupLoading}"
                    Background="{DynamicResource SystemChromeMediumColor}"
                    ZIndex="100">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="16">
                    <!-- Spinning cog -->
                    <icons:MaterialIcon Kind="Cog"
                                        Width="48" Height="48"
                                        HorizontalAlignment="Center"
                                        RenderTransformOrigin="50%,50%">
                        <icons:MaterialIcon.RenderTransform>
                            <RotateTransform/>
                        </icons:MaterialIcon.RenderTransform>
                        <icons:MaterialIcon.Styles>
                            <Style Selector="icons|MaterialIcon">
                                <Style.Animations>
                                    <Animation Duration="0:0:2" IterationCount="INFINITE">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="RotateTransform.Angle" Value="0"/>
                                        </KeyFrame>
                                        <KeyFrame Cue="100%">
                                            <Setter Property="RotateTransform.Angle" Value="360"/>
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </icons:MaterialIcon.Styles>
                    </icons:MaterialIcon>
                    <TextBlock Text="{Binding StartupStatusText}"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               Opacity="0.7"/>
                </StackPanel>
            </Border>
        </Panel>

    </Grid>
</Window>
