<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClipStudio.UI.ViewModels"
             xmlns:icons="using:Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="ClipStudio.UI.Views.TrashPageView"
             x:DataType="vm:TrashPageViewModel">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ===== Toolbar ===== -->
        <Border Grid.Row="0"
                Padding="16,10"
                BorderBrush="{DynamicResource SystemChromeHighColor}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                <TextBlock Grid.Column="0"
                           Text="Trash"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding Items.Count, StringFormat='{}{0} item(s) — auto-purged after 30 days'}"
                           FontSize="12"
                           Opacity="0.5"
                           VerticalAlignment="Center"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="#E74C3C"
                           VerticalAlignment="Center"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <!-- Refresh -->
                <Button Grid.Column="2"
                        Command="{Binding LoadCommand}"
                        ToolTip.Tip="Refresh"
                        Margin="0,0,6,0"
                        Padding="8,4">
                    <icons:MaterialIcon Kind="Refresh" Width="16" Height="16"/>
                </Button>

                <!-- Empty Trash -->
                <Button Grid.Column="3"
                        Command="{Binding EmptyTrashCommand}"
                        ToolTip.Tip="Permanently delete all items in trash"
                        IsEnabled="{Binding Items.Count}"
                        Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <icons:MaterialIcon Kind="DeleteSweep" Width="16" Height="16"/>
                        <TextBlock Text="Empty Trash" FontSize="12"/>
                    </StackPanel>
                </Button>

            </Grid>
        </Border>

        <!-- Loading indicator -->
        <ProgressBar Grid.Row="0"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}"
                     VerticalAlignment="Bottom"
                     Height="2"
                     Margin="0"/>

        <!-- ===== Column headers ===== -->
        <Border Grid.Row="1"
                Padding="12,6"
                Background="{DynamicResource SystemChromeLowColor}"
                BorderBrush="{DynamicResource SystemChromeHighColor}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,200,140,150">
                <TextBlock Grid.Column="0" Text="Name"            FontSize="11" Opacity="0.6" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="Deleted"         FontSize="11" Opacity="0.6" FontWeight="SemiBold" Margin="8,0,0,0"/>
                <TextBlock Grid.Column="2" Text="Auto-purge"      FontSize="11" Opacity="0.6" FontWeight="SemiBold" Margin="8,0,0,0"/>
                <TextBlock Grid.Column="3" Text="Actions"         FontSize="11" Opacity="0.6" FontWeight="SemiBold" Margin="8,0,0,0" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- ===== List ===== -->
        <ScrollViewer Grid.Row="2">
            <Panel>

                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Margin="0,60,0,0"
                            IsVisible="{Binding !Items.Count}">
                    <icons:MaterialIcon Kind="DeleteOutline" Width="48" Height="48" Opacity="0.2"
                                        HorizontalAlignment="Center"/>
                    <TextBlock Text="Trash is empty."
                               FontSize="15"
                               Opacity="0.4"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Deleted clips appear here and are permanently removed after 30 days."
                               FontSize="12"
                               Opacity="0.3"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Items}"
                              IsVisible="{Binding Items.Count}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:TrashedClipRowViewModel">
                            <Border Padding="12,8"
                                    BorderBrush="{DynamicResource SystemChromeHighColor}"
                                    BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,200,140,150">

                                    <!-- Name + original path -->
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding OriginalPath}"
                                                   FontSize="10"
                                                   Opacity="0.4"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding OriginalPath}"/>
                                    </StackPanel>

                                    <!-- Deleted at -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TrashedAtDisplay}"
                                               FontSize="12"
                                               Opacity="0.65"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>

                                    <!-- Days remaining -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DaysRemainingDisplay}"
                                               FontSize="12"
                                               Opacity="0.65"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="3"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0">
                                        <Button Command="{Binding RestoreCommand}"
                                                ToolTip.Tip="Restore clip to library"
                                                Padding="6,3">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <icons:MaterialIcon Kind="Restore" Width="12" Height="12"/>
                                                <TextBlock Text="Restore" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DeletePermanentlyCommand}"
                                                ToolTip.Tip="Move file to system Recycle Bin"
                                                Padding="6,3">
                                            <icons:MaterialIcon Kind="RecycleVariant" Width="14" Height="14"/>
                                        </Button>
                                        <Button Command="{Binding DeleteForeverCommand}"
                                                ToolTip.Tip="Delete file permanently (cannot be recovered)"
                                                Padding="6,3">
                                            <icons:MaterialIcon Kind="DeleteForever" Width="14" Height="14"/>
                                        </Button>
                                    </StackPanel>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Panel>
        </ScrollViewer>

    </Grid>
</UserControl>
