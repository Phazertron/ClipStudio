<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClipStudio.UI.ViewModels"
             xmlns:icons="using:Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="ClipStudio.UI.Views.TagManagerView"
             x:DataType="vm:TagManagerViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- ===== Toolbar ===== -->
        <Border Grid.Row="0"
                Padding="16,10"
                BorderBrush="{DynamicResource SystemChromeHighColor}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto">

                <!-- Filter box -->
                <TextBox Grid.Column="0"
                         Text="{Binding FilterText}"
                         Watermark="Filter tags..."
                         MaxWidth="320"
                         HorizontalAlignment="Left"
                         CornerRadius="6"/>

                <!-- Refresh -->
                <Button Grid.Column="1"
                        Command="{Binding LoadCommand}"
                        Content="Refresh"
                        Margin="8,0,0,0"/>

                <!-- New tag -->
                <Button Grid.Column="2"
                        Command="{Binding BeginCreateCommand}"
                        ToolTip.Tip="Create new tag"
                        Margin="6,0,0,0">
                    <icons:MaterialIcon Kind="TagAdd" Width="18" Height="18"/>
                </Button>

            </Grid>
        </Border>

        <!-- Loading indicator -->
        <ProgressBar Grid.Row="0"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}"
                     VerticalAlignment="Bottom"
                     Height="2"
                     Margin="0"/>

        <!-- ===== Main content: list + edit panel side by side ===== -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

            <!-- Tag list -->
            <ScrollViewer Grid.Column="0">
                <Panel Margin="12,12,12,24">

                    <!-- Empty state -->
                    <TextBlock Text="No tags found."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="15"
                               Opacity="0.4"
                               IsVisible="{Binding !Tags.Count}"/>

                    <ItemsControl ItemsSource="{Binding Tags}"
                                  IsVisible="{Binding Tags.Count}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:TagRowViewModel">
                                <Border Margin="{Binding IndentMargin}"
                                        Padding="10,8"
                                        CornerRadius="6"
                                        Background="{DynamicResource SystemChromeMediumLowColor}"
                                        BorderBrush="{DynamicResource SystemChromeHighColor}"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Tapped="OnTagRowTapped">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">

                                        <!-- Tree connector icon (children only) + colour swatch (always) -->
                                        <StackPanel Grid.Column="0"
                                                    Orientation="Horizontal"
                                                    Spacing="4"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center">
                                            <icons:MaterialIcon Kind="SubdirectoryArrowRight"
                                                                Width="14" Height="14"
                                                                Opacity="0.45"
                                                                IsVisible="{Binding IsChild}"/>
                                            <Border Width="14" Height="14"
                                                    CornerRadius="3"
                                                    Background="{Binding Color}"/>
                                        </StackPanel>

                                        <!-- Name + description -->
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="11"
                                                       Opacity="0.55"
                                                       IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="300"/>
                                        </StackPanel>

                                        <!-- Clip count badge -->
                                        <Border Grid.Column="2"
                                                Padding="6,2"
                                                CornerRadius="10"
                                                Background="{DynamicResource SystemChromeLowColor}"
                                                Margin="8,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ClipCount}"
                                                       FontSize="11"
                                                       Opacity="0.7"/>
                                        </Border>

                                        <!-- View in Library -->
                                        <Button Grid.Column="3"
                                                Command="{Binding ViewInLibraryCommand}"
                                                ToolTip.Tip="View clips in Library filtered by this tag"
                                                Padding="5">
                                            <icons:MaterialIcon Kind="LibraryMovie" Width="15" Height="15"/>
                                        </Button>

                                        <!-- Delete -->
                                        <Button Grid.Column="4"
                                                Command="{Binding DeleteCommand}"
                                                ToolTip.Tip="Delete tag"
                                                Padding="5">
                                            <icons:MaterialIcon Kind="DeleteCircle" Width="15" Height="15"/>
                                        </Button>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </Panel>
            </ScrollViewer>

            <!-- ===== Edit / Create panel ===== -->
            <Border Grid.Column="1"
                    Width="300"
                    BorderBrush="{DynamicResource SystemChromeHighColor}"
                    BorderThickness="1,0,0,0"
                    IsVisible="{Binding IsEditing}">

                <ScrollViewer>
                    <StackPanel Margin="16" Spacing="10">

                        <!-- Form title -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding EditFormTitle}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Command="{Binding CancelEditCommand}"
                                    ToolTip.Tip="Cancel"
                                    Padding="4">
                                <icons:MaterialIcon Kind="CloseThick" Width="16" Height="16"/>
                            </Button>
                        </Grid>

                        <!-- Name -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Name" FontSize="12" Opacity="0.7"/>
                            <TextBox Text="{Binding EditName}"
                                     Watermark="Tag name"
                                     FontSize="12"/>
                        </StackPanel>

                        <!-- Colour palette + hex entry -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Colour" FontSize="12" Opacity="0.7"/>

                            <!-- Swatch grid -->
                            <ItemsControl ItemsSource="{Binding ColorPalette}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:ColorSwatchViewModel">
                                        <Button Command="{Binding SelectCommand}"
                                                Width="24" Height="24"
                                                Padding="0"
                                                Margin="2"
                                                CornerRadius="4"
                                                Background="{Binding Color}"
                                                BorderThickness="0"
                                                ToolTip.Tip="{Binding Color}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Manual hex entry + live preview swatch -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <TextBox Grid.Column="0"
                                         Text="{Binding EditColor}"
                                         Watermark="#607D8B"
                                         FontSize="12"/>
                                <Border Grid.Column="1"
                                        Width="28" Height="28"
                                        CornerRadius="4"
                                        Margin="6,0,0,0"
                                        Background="{Binding EditColor}"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- Description -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Description" FontSize="12" Opacity="0.7"/>
                            <TextBox Text="{Binding EditDescription}"
                                     Watermark="Optional description"
                                     AcceptsReturn="True"
                                     MinHeight="56"
                                     MaxHeight="100"
                                     TextWrapping="Wrap"
                                     FontSize="12"/>
                        </StackPanel>

                        <!-- Parent tag -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Parent tag" FontSize="12" Opacity="0.7"/>
                            <ComboBox ItemsSource="{Binding ParentTagOptions}"
                                      SelectedItem="{Binding SelectedParentTagOption}"
                                      HorizontalAlignment="Stretch"
                                      FontSize="12">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="vm:ParentTagOptionViewModel">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Error message -->
                        <TextBlock Text="{Binding SaveError}"
                                   FontSize="12"
                                   Foreground="#E74C3C"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding SaveError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        <!-- Save -->
                        <Button Command="{Binding SaveCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                FontSize="12">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="ContentSave" Width="16" Height="16"/>
                                <TextBlock Text="Save"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>
</UserControl>
