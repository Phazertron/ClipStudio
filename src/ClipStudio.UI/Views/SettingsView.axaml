<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClipStudio.UI.ViewModels"
             xmlns:sections="using:ClipStudio.UI.ViewModels.Settings"
             xmlns:icons="using:Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="ClipStudio.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             x:CompileBindings="True">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header / loading bar -->
        <Border Grid.Row="0"
                Padding="16,10"
                BorderBrush="{DynamicResource SystemChromeHighColor}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="Settings"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsLoading}"
                             Width="80" Height="4"/>
            </Grid>
        </Border>

        <!-- Section navigation + the selected section -->
        <Grid Grid.Row="1" ColumnDefinitions="180,*">

            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource SystemChromeHighColor}"
                    BorderThickness="0,0,1,0">
                <ListBox ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="8,12">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="sections:SettingsSectionViewModel">
                            <Grid ColumnDefinitions="Auto,*">
                                <!-- The class is only applied while the section is actually
                                     asking for a visit, so the default foreground - including
                                     whatever the selected row uses - is left alone otherwise. -->
                                <icons:MaterialIcon Grid.Column="0"
                                                    Kind="{Binding Icon}"
                                                    Classes.needsAttention="{Binding NeedsAttention}"
                                                    Width="16" Height="16"
                                                    VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           Margin="10,0,0,0"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>

                        <!-- Amber rather than the red used for errors: these entries need a
                             decision, and most of them are not faults. -->
                        <Style Selector="icons|MaterialIcon.needsAttention">
                            <Setter Property="Foreground" Value="#F1C40F"/>
                        </Style>
                    </ListBox.Styles>
                </ListBox>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding SelectedSection}"/>

        </Grid>

        <!-- Save bar: one Save for every section, so a change made in any of them is persisted -->
        <Border Grid.Row="2"
                Padding="24,12"
                BorderBrush="{DynamicResource SystemChromeHighColor}"
                BorderThickness="0,1,0,0">
            <!-- A Grid, not a StackPanel: a horizontal StackPanel measures its children with
                 infinite width, so TextWrapping on the status text did nothing and a long
                 sanitize summary ran off the edge of the window. -->
            <Grid ColumnDefinitions="Auto,*">
                <Button Grid.Column="0"
                        Command="{Binding SavePreferencesCommand}"
                        VerticalAlignment="Center"
                        FontSize="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="ContentSave" Width="16" Height="16"/>
                        <TextBlock Text="Save Preferences"/>
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           FontSize="12"
                           Opacity="0.7"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </Grid>
        </Border>

    </Grid>
</UserControl>
