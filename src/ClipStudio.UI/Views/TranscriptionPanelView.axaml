<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClipStudio.UI.ViewModels"
             xmlns:icons="using:Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="400"
             x:Class="ClipStudio.UI.Views.TranscriptionPanelView"
             x:DataType="vm:TranscriptionViewModel">

    <StackPanel Spacing="8" Margin="0,4,0,0">

        <!-- Caption track checkboxes -->
        <StackPanel Spacing="2"
                    IsVisible="{Binding CaptionTracks.Count}"
                    IsEnabled="{Binding !IsTranscribing}">
            <TextBlock Text="Caption tracks"
                       FontSize="10"
                       Opacity="0.55"
                       Margin="0,0,0,2"/>
            <ItemsControl ItemsSource="{Binding CaptionTracks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CaptionTrackViewModel">
                        <CheckBox IsChecked="{Binding IsIncluded}"
                                  Content="{Binding Name}"
                                  FontSize="11"
                                  Padding="2,1"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Transcribe / Cancel button row -->
        <StackPanel Orientation="Horizontal" Spacing="6">

            <!-- Transcribe button -->
            <Button Command="{Binding TranscribeCommand}"
                    IsEnabled="{Binding CanTranscribe}"
                    ToolTip.Tip="Start transcription using the selected caption tracks"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <icons:MaterialIcon Kind="Microphone" Width="14" Height="14"/>
                    <TextBlock Text="Transcribe" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Cancel button (visible only while transcribing) -->
            <Button Command="{Binding CancelCommand}"
                    IsVisible="{Binding IsTranscribing}"
                    ToolTip.Tip="Cancel transcription"
                    Padding="6,4">
                <icons:MaterialIcon Kind="Close" Width="14" Height="14"/>
            </Button>

        </StackPanel>

        <!-- Progress bar (visible while transcribing) -->
        <ProgressBar IsVisible="{Binding IsTranscribing}"
                     Value="{Binding Progress}"
                     Minimum="0"
                     Maximum="1"
                     Height="4"
                     IsIndeterminate="False"/>

        <!-- Status message -->
        <TextBlock Text="{Binding StatusMessage}"
                   FontSize="10"
                   Opacity="0.6"
                   TextWrapping="Wrap"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

        <!-- Existing transcription date line -->
        <StackPanel Orientation="Horizontal"
                    Spacing="4"
                    IsVisible="{Binding HasExistingTranscription}">
            <icons:MaterialIcon Kind="CheckCircleOutline" Width="12" Height="12" Opacity="0.5"/>
            <TextBlock Text="{Binding LastTranscriptionDate, StringFormat='Transcribed: {0}'}"
                       FontSize="10"
                       Opacity="0.5"/>
        </StackPanel>

        <!-- Segment list -->
        <ScrollViewer MaxHeight="280"
                      IsVisible="{Binding Segments.Count}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden">
            <ItemsControl ItemsSource="{Binding Segments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TranscriptionSegmentViewModel">
                        <Border Padding="6,4"
                                Margin="0,1"
                                CornerRadius="3"
                                Background="Transparent">
                            <Border.Styles>
                                <Style Selector="Border:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark3}"/>
                                </Style>
                            </Border.Styles>

                            <Panel>

                                <!-- Active-segment highlight overlay (behind content, non-interactive) -->
                                <Border Background="#26FFFFFF"
                                        CornerRadius="3"
                                        IsVisible="{Binding IsCurrentlyPlaying}"
                                        IsHitTestVisible="False"/>

                                <StackPanel Spacing="4">

                                <!-- Display mode -->
                                <Grid ColumnDefinitions="80,*,Auto"
                                      IsVisible="{Binding !IsEditing}"
                                      Cursor="Hand">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding TimestampRange}"
                                               FontSize="10"
                                               FontFamily="Consolas,Courier New,monospace"
                                               Opacity="0.55"
                                               VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Text}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="6,0,0,0"/>
                                    <Button Grid.Column="2"
                                            Command="{Binding BeginEditCommand}"
                                            ToolTip.Tip="Edit this segment"
                                            Padding="4,2"
                                            Opacity="0.45"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            VerticalAlignment="Top">
                                        <icons:MaterialIcon Kind="Pencil" Width="12" Height="12"/>
                                    </Button>
                                </Grid>

                                <!-- Edit mode -->
                                <StackPanel IsVisible="{Binding IsEditing}" Spacing="4">
                                    <TextBlock Text="{Binding TimestampRange}"
                                               FontSize="10"
                                               FontFamily="Consolas,Courier New,monospace"
                                               Opacity="0.55"/>
                                    <TextBox Text="{Binding EditedText}"
                                             AcceptsReturn="True"
                                             MaxLines="6"
                                             FontSize="11"
                                             TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button Command="{Binding SaveEditCommand}"
                                                IsEnabled="{Binding !IsSaving}"
                                                ToolTip.Tip="Save correction"
                                                Padding="6,3">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <icons:MaterialIcon Kind="Check" Width="12" Height="12"/>
                                                <TextBlock Text="Save" FontSize="10" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding CancelEditCommand}"
                                                ToolTip.Tip="Discard edit"
                                                Padding="6,3">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <icons:MaterialIcon Kind="Close" Width="12" Height="12"/>
                                                <TextBlock Text="Cancel" FontSize="10" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                </StackPanel>

                            </Panel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </StackPanel>

</UserControl>
