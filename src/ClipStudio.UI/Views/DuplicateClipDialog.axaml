<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClipStudio.UI.ViewModels"
        xmlns:icons="using:Material.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="380"
        x:Class="ClipStudio.UI.Views.DuplicateClipDialog"
        x:DataType="vm:DuplicateClipDialogViewModel"
        x:CompileBindings="True"
        Title="Duplicate Clip"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="24" Spacing="16">

        <!-- Title -->
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <icons:MaterialIcon Kind="ContentDuplicate" Width="22" Height="22" Opacity="0.8"/>
            <TextBlock Text="This clip is already in your library"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Text="The file below has the same contents as a clip you already have. It was not caught by name, so the two differ somewhere - check which one you want before deciding."
                   FontSize="12"
                   Opacity="0.7"
                   TextWrapping="Wrap"/>

        <!-- Incoming file -->
        <Border Background="#20FFFFFF" CornerRadius="4" Padding="12">
            <StackPanel Spacing="3">
                <TextBlock Text="Being imported" FontSize="11" Opacity="0.6"/>
                <TextBlock Text="{Binding IncomingFileName}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding IncomingFolder}"
                           FontSize="11"
                           Opacity="0.55"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- Existing clip -->
        <Border Background="#20FFFFFF" CornerRadius="4" Padding="12">
            <StackPanel Spacing="3">
                <TextBlock Text="Already in the library" FontSize="11" Opacity="0.6"/>
                <TextBlock Text="{Binding ExistingFileName}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding ExistingFolder}"
                           FontSize="11"
                           Opacity="0.55"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding ExistingRecordedAt}"
                           FontSize="11"
                           Opacity="0.55"/>
            </StackPanel>
        </Border>

        <!-- Apply to the rest, offered only when there are more waiting -->
        <CheckBox Content="{Binding RemainingLabel}"
                  IsChecked="{Binding ApplyToRemaining}"
                  IsVisible="{Binding HasRemaining}"
                  FontSize="12"/>

        <!-- Actions -->
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Import anyway"
                    Command="{Binding ImportAnywayCommand}"
                    Padding="14,6"/>
            <Button Content="Skip"
                    Command="{Binding SkipCommand}"
                    IsDefault="True"
                    Padding="14,6"/>
        </StackPanel>

    </StackPanel>
</Window>
