<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClipStudio.UI.ViewModels.WizardSteps"
             xmlns:icons="using:Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="580" d:DesignHeight="360"
             x:Class="ClipStudio.UI.Views.WizardSteps.FfmpegStepView"
             x:DataType="vm:FfmpegStepViewModel"
             x:CompileBindings="True">

    <StackPanel Spacing="16" Margin="8">

        <TextBlock Text="ClipStudio uses FFmpeg to generate thumbnails, preview strips, and exports."
                   FontSize="13"
                   Opacity="0.7"
                   TextWrapping="Wrap"/>

        <!-- Checking spinner -->
        <StackPanel Orientation="Horizontal" Spacing="10"
                    IsVisible="{Binding IsChecking}"
                    VerticalAlignment="Center">
            <ProgressBar IsIndeterminate="True" Width="120" Height="4" VerticalAlignment="Center"/>
            <TextBlock Text="Detecting FFmpeg..." FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Found: bundled -->
        <Border CornerRadius="6"
                Background="#1A27AE60"
                BorderBrush="#2727AE60"
                BorderThickness="1"
                Padding="12,10"
                IsVisible="{Binding IsBundled}">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="CheckCircle" Width="18" Height="18"
                                        Foreground="#27AE60" VerticalAlignment="Center"/>
                    <TextBlock Text="FFmpeg is bundled with ClipStudio"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#27AE60" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding DetectedFolder}"
                           FontSize="11" Opacity="0.6"
                           TextTrimming="CharacterEllipsis"
                           Margin="26,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Found: system PATH -->
        <Border CornerRadius="6"
                Background="#1A2980B9"
                BorderBrush="#272980B9"
                BorderThickness="1"
                Padding="12,10"
                IsVisible="{Binding IsOnPath}">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="CheckCircle" Width="18" Height="18"
                                        Foreground="#2980B9" VerticalAlignment="Center"/>
                    <TextBlock Text="FFmpeg found on system PATH"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#2980B9" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding DetectedFolder}"
                           FontSize="11" Opacity="0.6"
                           TextTrimming="CharacterEllipsis"
                           Margin="26,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Not found -->
        <StackPanel Spacing="12" IsVisible="{Binding NeedsManualPath}">

            <Border CornerRadius="6"
                    Background="#1AE67E22"
                    BorderBrush="#27E67E22"
                    BorderThickness="1"
                    Padding="12,10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="AlertCircle" Width="18" Height="18"
                                        Foreground="#E67E22" VerticalAlignment="Center"/>
                    <TextBlock Text="FFmpeg was not found automatically."
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#E67E22" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Enter the folder that contains ffmpeg.exe and ffprobe.exe, or leave blank to configure later in Settings."
                       FontSize="12"
                       Opacity="0.7"
                       TextWrapping="Wrap"/>

            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                         Text="{Binding ManualFolder}"
                         Watermark="e.g. C:\tools\ffmpeg\bin"
                         FontSize="12"/>
                <Button Grid.Column="1"
                        Command="{Binding BrowseCommand}"
                        Margin="8,0,0,0"
                        ToolTip.Tip="Browse for FFmpeg folder">
                    <icons:MaterialIcon Kind="FolderSearch" Width="16" Height="16"/>
                </Button>
            </Grid>

        </StackPanel>

        <!-- Note: step is always skippable -->
        <TextBlock Text="This step can be skipped. Thumbnails and exports will not work until FFmpeg is configured."
                   FontSize="11"
                   Opacity="0.5"
                   TextWrapping="Wrap"
                   IsVisible="{Binding NeedsManualPath}"/>

    </StackPanel>

</UserControl>
