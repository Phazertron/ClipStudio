<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClipStudio.UI.ViewModels.Settings"
             xmlns:rows="using:ClipStudio.UI.ViewModels"
             xmlns:icons="using:Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="700"
             x:Class="ClipStudio.UI.Views.Settings.AboutSectionView"
             x:DataType="vm:AboutSectionViewModel"
             x:CompileBindings="True">

    <ScrollViewer>
        <StackPanel Margin="24,16" Spacing="24" MaxWidth="700" HorizontalAlignment="Left">
                <StackPanel Spacing="8">
                    <TextBlock Text="About"
                               FontSize="15"
                               FontWeight="SemiBold"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding OpenKofiCommand}"
                                FontSize="12"
                                Background="#E8476A"
                                Foreground="White">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="CoffeeMaker" Width="16" Height="16"/>
                                <TextBlock Text="Support on Ko-fi"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SendFeedbackCommand}"
                                FontSize="12"
                                Background="#27AE60"
                                Foreground="White">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="BugOutline" Width="16" Height="16"/>
                                <TextBlock Text="Send Feedback / Report Bug"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="{Binding AppVersion}"
                               FontSize="11"
                               Opacity="0.4"/>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Command="{Binding CheckForUpdatesCommand}"
                                IsEnabled="{Binding !IsCheckingForUpdates}"
                                FontSize="12">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="Refresh" Width="16" Height="16"/>
                                <TextBlock Text="Check for updates"/>
                            </StackPanel>
                        </Button>

                        <icons:MaterialIcon Kind="{Binding UpdateStatusIcon}"
                                            Width="16" Height="16"
                                            Opacity="0.7"
                                            VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding UpdateStatusText}"
                                   FontSize="12"
                                   Opacity="0.7"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
        </StackPanel>
    </ScrollViewer>

</UserControl>
