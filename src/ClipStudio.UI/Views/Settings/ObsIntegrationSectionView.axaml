<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClipStudio.UI.ViewModels.Settings"
             xmlns:rows="using:ClipStudio.UI.ViewModels"
             xmlns:icons="using:Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="700"
             x:Class="ClipStudio.UI.Views.Settings.ObsIntegrationSectionView"
             x:DataType="vm:ObsIntegrationSectionViewModel"
             x:CompileBindings="True">

    <ScrollViewer>
        <StackPanel Margin="24,16" Spacing="24" MaxWidth="700" HorizontalAlignment="Left">
                <StackPanel Spacing="12">
                    <TextBlock Text="OBS Integration"
                               FontSize="15"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Use the bundled OBS Python script to automatically embed the active game name in replay buffer filenames. ClipStudio then reads this tag on import."
                               FontSize="12"
                               Opacity="0.7"
                               TextWrapping="Wrap"/>

                    <!-- Script status -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Script status"
                                   FontSize="12"
                                   Opacity="0.7"/>
                        <TextBlock Text="{Binding ObsScriptStatus}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding OpenObsScriptsFolderCommand}"
                                FontSize="12">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="FolderOpen" Width="16" Height="16"/>
                                <TextBlock Text="Open OBS Scripts Folder"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OnCopyObsScriptPathClicked"
                                FontSize="12">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="ContentCopy" Width="16" Height="16"/>
                                <TextBlock Text="Copy Script Path"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Installation instructions -->
                    <TextBlock FontSize="11"
                               Opacity="0.55"
                               TextWrapping="Wrap">
                        <Run Text="To install: in OBS go to"/>
                        <Run Text=" Tools &gt; Scripts &gt; +" FontWeight="SemiBold"/>
                        <Run Text=", then select the script file shown above."/>
                    </TextBlock>
                </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>
